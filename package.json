{
  "name": "dsh-memory-vault",
  "version": "0.1.1",
  "description": "Knowledge and memory vault for DSH: memory groups with automatic summarization and free assignment between conversation memory and the knowledge base.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node --no-warnings tests/smoke.mjs"
  }
}
